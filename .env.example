# ==============================================================================
# Fitmeezo Environment Configuration Template (.env.example)
# Copy this file to .env and customize the values for your environment.
# DO NOT commit real secrets, private keys, or passwords to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DJANGO CORE SECURITY & RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
# In production: Generate a unique, cryptographically strong key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# In local development: Leave blank or set a dev key.
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production

# Set DEBUG=False in production. Set DEBUG=True only for local testing.
DEBUG=True

# Comma-separated list of host/domain names that this Django site can serve.
# In local development: 127.0.0.1,localhost
# In production: fitmeezo-website.onrender.com,fitmeezo.in,www.fitmeezo.in
ALLOWED_HOSTS=127.0.0.1,localhost

# Comma-separated list of trusted origins for CSRF POST requests over HTTPS.
# In production: https://fitmeezo-website.onrender.com,https://fitmeezo.in
CSRF_TRUSTED_ORIGINS=https://fitmeezo-website.onrender.com

# ------------------------------------------------------------------------------
# 2. HTTPS & SSL SECURITY HEADERS (PRODUCTION ONLY)
# ------------------------------------------------------------------------------
# Automatically active when DEBUG=False. You can fine-tune or override them here:
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Option A (Cloud / PaaS): Full PostgreSQL connection URI
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# Option B (Standard): Individual environment variables
# In local development: Leave DB_ENGINE=sqlite or unset to use db.sqlite3 fallback.
# In production: Set DB_ENGINE=postgresql and configure PostgreSQL credentials.
DB_ENGINE=sqlite
DB_NAME=fitmeezo_db
DB_USER=postgres
DB_PASSWORD=your_postgresql_password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60
# DB_SSLMODE=require  # Options: require, verify-ca, verify-full, prefer, disable (for AWS RDS/Neon/Supabase)

# ------------------------------------------------------------------------------
# 4. BRAND & LOCALIZATION METADATA
# ------------------------------------------------------------------------------
BRAND_NAME=Fitmeezo
BRAND_TAGLINE=SHOP SMART • LIVE BETTER
CURRENCY=INR
CURRENCY_SYMBOL=₹
TIME_ZONE=Asia/Kolkata

# ------------------------------------------------------------------------------
# 5. SOCIAL AUTHENTICATION (GOOGLE OAUTH 2.0 / OPENID CONNECT)
# ------------------------------------------------------------------------------
# Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Authorized Javascript Origins:
#   http://127.0.0.1:8000
#   http://localhost:8000
#   https://fitmeezo-website.onrender.com
# Authorized Redirect URIs:
#   http://127.0.0.1:8000/accounts/google/login/callback/
#   http://localhost:8000/accounts/google/login/callback/
#   https://fitmeezo-website.onrender.com/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 6. RAZORPAY PAYMENT GATEWAY
# ------------------------------------------------------------------------------
# Razorpay Dashboard: https://dashboard.razorpay.com/app/keys
# Test Mode: Use rzp_test_xxx keys for sandbox simulation.
# Live Mode: Add rzp_live_xxx keys upon business launch.
# Leave keys empty or unset to safely keep gateway disabled and permit COD only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR

# ------------------------------------------------------------------------------
# 7. EMAIL DELIVERY & SMTP CONFIGURATION
# ------------------------------------------------------------------------------
# In local development: Defaults to console backend (prints emails to terminal stdout):
#   EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# In production: Set to SMTP backend:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_app_password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=Fitmeezo <support@fitmeezo.com>
SERVER_EMAIL=Fitmeezo Alerts <support@fitmeezo.com>
SUPPORT_EMAIL=support@fitmeezo.com

# ------------------------------------------------------------------------------
# 8. INVOICE PDF, PACKING SLIP & TAX RECORDS (PHASE 8)
# ------------------------------------------------------------------------------
FITMEEZO_INVOICE_PREFIX=FM-INV
FITMEEZO_SELLER_INVOICE_PREFIX=FM-SINV
FITMEEZO_INVOICE_ISSUANCE_RULE=on_payment_or_cod
FITMEEZO_INVOICE_ISSUER_MODEL=composite
FITMEEZO_LEGAL_ENTITY_NAME=Fitmeezo India Retail
FITMEEZO_PLATFORM_GSTIN=
FITMEEZO_PLATFORM_PAN=
FITMEEZO_PLATFORM_CIN=
FITMEEZO_REGISTERED_OFFICE_ADDRESS=Plot 42, Industrial Area Phase II, Bengaluru, Karnataka 560100, India
SUPPORT_PHONE=+91 940885323
SUPPORT_HOURS=Mon - Sat, 10:00 AM - 7:00 PM IST

# ------------------------------------------------------------------------------
# 9. TRANSACTIONAL SMS & SELLER MOBILE OTP (PRODUCTION INDIA GATEWAYS)
# ------------------------------------------------------------------------------
# SMS_PROVIDER options: 'msg91' (recommended), 'textlocal', 'fast2sms', 'console' (dev), 'mock' (tests)
SMS_PROVIDER=msg91

# Generic SMS credentials (shared across providers)
SMS_AUTH_KEY=your_provider_auth_or_api_key
SMS_API_KEY=your_provider_auth_or_api_key
SMS_TEMPLATE_ID=your_dlt_approved_template_id
SMS_SENDER_ID=FTMEZO

# Provider-Specific Option 1: MSG91 (Official Send OTP v5)
# Dashboard: https://control.msg91.com/
# Requires DLT registered Entity ID, Header/Sender ID (e.g. FTMEZO), and approved OTP Template ID
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=FTMEZO

# Provider-Specific Option 2: Textlocal India
# Dashboard: https://www.textlocal.in/
TEXTLOCAL_API_KEY=
TEXTLOCAL_SENDER_ID=FTMEZO
TEXTLOCAL_TEMPLATE_TEXT=Your Fitmeezo verification code is {otp}. Valid for 5 minutes. Do not share this code.

# Provider-Specific Option 3: Fast2SMS (India Quick OTP)
FAST2SMS_API_KEY=

# Local development OTP display toggle (strictly ignored & disabled in production when DEBUG=False)
SELLER_OTP_DEV_MODE=False

# ------------------------------------------------------------------------------
# 10. CLOUDINARY PERSISTENT MEDIA STORAGE (PRODUCTION & STAGING)
# ------------------------------------------------------------------------------
# Cloudinary Dashboard: https://cloudinary.com/console
# When these variables are set, user-uploaded product images, category banners,
# gallery photos, and return condition proofs are stored securely on Cloudinary.
# In local development without Cloudinary, leave these empty to use local media/ folder.
#
# Option A: Full connection URL
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

# Option B: Discrete credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional settings:
CLOUDINARY_SECURE=True
CLOUDINARY_MEDIA_TAG=media
