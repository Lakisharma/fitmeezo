# ==============================================================================
# Fitmeezo Environment Configuration Template (.env.example)
# Copy this file to .env and customize the values for your environment.
# DO NOT commit real secrets, private keys, or passwords to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DJANGO CORE SECURITY & RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
# In production: Generate a unique, cryptographically strong key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# In local development: Leave blank or set a dev key.
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production

# Set DEBUG=False in production. Set DEBUG=True only for local testing.
DEBUG=True

# Comma-separated list of host/domain names that this Django site can serve.
# In local development: 127.0.0.1,localhost
# In production: fitmeezo-website.onrender.com,fitmeezo.in,www.fitmeezo.in
ALLOWED_HOSTS=127.0.0.1,localhost

# Comma-separated list of trusted origins for CSRF POST requests over HTTPS.
# In production: https://fitmeezo-website.onrender.com,https://fitmeezo.in
CSRF_TRUSTED_ORIGINS=https://fitmeezo-website.onrender.com

# ------------------------------------------------------------------------------
# 2. HTTPS & SSL SECURITY HEADERS (PRODUCTION ONLY)
# ------------------------------------------------------------------------------
# Automatically active when DEBUG=False. You can fine-tune or override them here:
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Option A (Cloud / PaaS): Full PostgreSQL connection URI
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# Option B (Standard): Individual environment variables
# In local development: Leave DB_ENGINE=sqlite or unset to use db.sqlite3 fallback.
# In production: Set DB_ENGINE=postgresql and configure PostgreSQL credentials.
DB_ENGINE=sqlite
DB_NAME=fitmeezo_db
DB_USER=postgres
DB_PASSWORD=your_postgresql_password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60
# DB_SSLMODE=require  # Options: require, verify-ca, verify-full, prefer, disable (for AWS RDS/Neon/Supabase)

# ------------------------------------------------------------------------------
# 4. BRAND & LOCALIZATION METADATA
# ------------------------------------------------------------------------------
BRAND_NAME=Fitmeezo
BRAND_TAGLINE=SHOP SMART • LIVE BETTER
CURRENCY=INR
CURRENCY_SYMBOL=₹
TIME_ZONE=Asia/Kolkata

# ------------------------------------------------------------------------------
# 5. SOCIAL AUTHENTICATION (GOOGLE & FACEBOOK OAUTH 2.0)
# ------------------------------------------------------------------------------
# Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Authorized Redirect URI: https://<yourdomain>/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Meta for Developers: https://developers.facebook.com/apps/
# Authorized Redirect URI: https://<yourdomain>/accounts/facebook/login/callback/
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 6. RAZORPAY PAYMENT GATEWAY
# ------------------------------------------------------------------------------
# Razorpay Dashboard: https://dashboard.razorpay.com/app/keys
# Test Mode: Use rzp_test_xxx keys for sandbox simulation.
# Live Mode: Add rzp_live_xxx keys upon business launch.
# Leave keys empty or unset to safely keep gateway disabled and permit COD only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR

# ------------------------------------------------------------------------------
# 7. EMAIL DELIVERY & SMTP CONFIGURATION
# ------------------------------------------------------------------------------
# In local development: Defaults to console backend (prints emails to terminal stdout):
#   EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# In production: Set to SMTP backend:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_app_password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=Fitmeezo <support@fitmeezo.com>
SERVER_EMAIL=Fitmeezo Alerts <support@fitmeezo.com>
SUPPORT_EMAIL=support@fitmeezo.com

# ------------------------------------------------------------------------------
# 8. INVOICE PDF, PACKING SLIP & TAX RECORDS (PHASE 8)
# ------------------------------------------------------------------------------
FITMEEZO_INVOICE_PREFIX=FM-INV
FITMEEZO_SELLER_INVOICE_PREFIX=FM-SINV
FITMEEZO_INVOICE_ISSUANCE_RULE=on_payment_or_cod
FITMEEZO_INVOICE_ISSUER_MODEL=composite
FITMEEZO_LEGAL_ENTITY_NAME=Fitmeezo India Retail
FITMEEZO_PLATFORM_GSTIN=
FITMEEZO_PLATFORM_PAN=
FITMEEZO_PLATFORM_CIN=
FITMEEZO_REGISTERED_OFFICE_ADDRESS=Plot 42, Industrial Area Phase II, Bengaluru, Karnataka 560100, India
SUPPORT_PHONE=+91 98765 43210
SUPPORT_HOURS=Mon - Sat, 10:00 AM - 7:00 PM IST
