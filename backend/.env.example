# ==============================================================================
# Fitmeezo Environment Configuration Template (.env.example)
# Copy this file to .env and customize the values for your environment.
# DO NOT commit real secrets or credentials to version control.
# ==============================================================================

# Django Security
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
DEBUG=True
# In local development: 127.0.0.1,localhost
# In production: fitmeezo.com,www.fitmeezo.com
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://fitmeezo.com

# Database Configuration
# Option A (Cloud / PaaS): Full PostgreSQL connection URI
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# Option B (Standard): Individual environment variables
# Set DB_ENGINE=postgresql to connect to PostgreSQL.
# Leave DB_ENGINE=sqlite or unset to use local fallback SQLite database.
DB_ENGINE=sqlite
DB_NAME=fitmeezo_db
DB_USER=postgres
DB_PASSWORD=your_postgresql_password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60
# DB_SSLMODE=require  # Options: require, verify-ca, verify-full, prefer, disable (for AWS RDS/Neon/Supabase)

# Fitmeezo Brand & Localization Settings
BRAND_NAME=Fitmeezo
BRAND_TAGLINE=SHOP SMART • LIVE BETTER
CURRENCY=INR
CURRENCY_SYMBOL=₹
TIME_ZONE=Asia/Kolkata

# ==============================================================================
# Shipping & Shiprocket Logistics Configuration (Phase 5)
# ==============================================================================
# Shiprocket API Base URL (Default: https://apiv2.shiprocket.in/v2/console)
SHIPROCKET_API_BASE_URL=https://apiv2.shiprocket.in/v2/console
# Provider account credentials (keep secret; never commit real credentials)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=
# Secret token configured in Shiprocket Webhooks dashboard (passed in x-api-key header)
SHIPROCKET_WEBHOOK_TOKEN=
# Backward compatibility aliases
SHIPROCKET_API_EMAIL=
SHIPROCKET_API_PASSWORD=
# Timeouts and retries
SHIPROCKET_CONNECT_TIMEOUT=5.0
SHIPROCKET_READ_TIMEOUT=15.0
SHIPROCKET_MAX_RETRIES=3
SHIPROCKET_BACKOFF_FACTOR=0.5
# Set SHIPROCKET_MOCK_MODE=True for local/offline testing without live provider calls
SHIPROCKET_MOCK_MODE=False
# Token cache timeout in seconds (default: 604800 = 7 days)
SHIPROCKET_TOKEN_CACHE_TIMEOUT=604800
# Volumetric weight divisor (5000 is standard for Indian surface logistics; 4000 for air express)
SHIPROCKET_VOLUMETRIC_DIVISOR=5000.00

# Platform Central Warehouse Configuration (For platform-fulfilled packages)
PLATFORM_WAREHOUSE_NAME=Fitmeezo Central Fulfillment Center
PLATFORM_WAREHOUSE_CONTACT=Fitmeezo Operations
PLATFORM_WAREHOUSE_PHONE=9408853230
PLATFORM_WAREHOUSE_EMAIL=support@fitmeezo.com
PLATFORM_WAREHOUSE_ADDRESS1=Plot 42, Industrial Area Phase II
PLATFORM_WAREHOUSE_ADDRESS2=
PLATFORM_WAREHOUSE_CITY=Bengaluru
PLATFORM_WAREHOUSE_STATE=Karnataka
PLATFORM_WAREHOUSE_PIN=560100
PLATFORM_WAREHOUSE_VERIFIED=False

# Phase 8: Invoices & Tax Configuration
FITMEEZO_INVOICE_PREFIX=FM-INV
FITMEEZO_SELLER_INVOICE_PREFIX=FM-SINV
FITMEEZO_INVOICE_ISSUANCE_RULE=on_payment_or_cod
FITMEEZO_INVOICE_ISSUER_MODEL=composite
FITMEEZO_LEGAL_ENTITY_NAME=Fitmeezo India Retail
FITMEEZO_PLATFORM_GSTIN=
FITMEEZO_PLATFORM_PAN=
FITMEEZO_PLATFORM_CIN=
FITMEEZO_REGISTERED_OFFICE_ADDRESS=Plot 42, Industrial Area Phase II, Bengaluru, Karnataka 560100, India
SUPPORT_PHONE=+91 940885323
SUPPORT_HOURS=Mon - Sat, 10:00 AM - 7:00 PM IST

# ==============================================================================
# Transactional SMS & Seller OTP Gateway (Production India Providers)
# ==============================================================================
# SMS_PROVIDER options:
#   'msg91'     - Recommended for India (TRAI DLT compliant OTP Flow / Send OTP API)
#   'textlocal' - Textlocal India Gateway
#   'fast2sms'  - Fast2SMS Quick OTP Gateway
#   'console'   - Local development only (prints OTP to terminal when DEBUG=True)
#   'mock'      - Automated test suite only
SMS_PROVIDER=msg91

# Generic SMS credentials (shared across providers)
SMS_AUTH_KEY=your_provider_auth_or_api_key
SMS_API_KEY=your_provider_auth_or_api_key
SMS_TEMPLATE_ID=your_dlt_approved_template_id
SMS_SENDER_ID=FTMEZO

# Provider-Specific Option 1: MSG91 (Official Send OTP v5)
# Dashboard: https://control.msg91.com/
# Requires DLT registered Entity ID, Header/Sender ID (e.g. FTMEZO), and approved OTP Template ID
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=FTMEZO

# Provider-Specific Option 2: Textlocal India
# Dashboard: https://www.textlocal.in/
TEXTLOCAL_API_KEY=
TEXTLOCAL_SENDER_ID=FTMEZO
TEXTLOCAL_TEMPLATE_TEXT=Your Fitmeezo verification code is {otp}. Valid for 5 minutes. Do not share this code.

# Provider-Specific Option 3: Fast2SMS (India Quick OTP)
FAST2SMS_API_KEY=

# Local development OTP display toggle (strictly ignored & disabled in production when DEBUG=False)
SELLER_OTP_DEV_MODE=False

# ------------------------------------------------------------------------------
# 10. CLOUDINARY PERSISTENT MEDIA STORAGE (PRODUCTION & STAGING)
# ------------------------------------------------------------------------------
# Cloudinary Dashboard: https://cloudinary.com/console
# When these variables are set, user-uploaded product images, category banners,
# gallery photos, and return condition proofs are stored securely on Cloudinary.
# In local development without Cloudinary, leave these empty to use local media/ folder.
#
# Option A: Full connection URL
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

# Option B: Discrete credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional settings:
CLOUDINARY_SECURE=True
CLOUDINARY_MEDIA_TAG=media
